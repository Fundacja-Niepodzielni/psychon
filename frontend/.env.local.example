# Adres backendu (klient API sam dokleja /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Konta Niepodzielni (Keycloak) — adres realmu, jaki widzi przeglądarka
# (issuer). Bez wartości domyślnej: zły adres tu ma być błędem uruchomienia,
# nie cichym połączeniem donikąd. `psychon-web` (klient) jest publiczny —
# bez sekretu; jeśli kiedykolwiek ktoś każe go tu wpisać, to znaczy, że realm
# i ta dokumentacja się rozjechały.
AUTH_KEYCLOAK_ISSUER=https://localhost:PORT/realms/niepodzielni

# Klucz podpisu/szyfrowania ciasteczka sesji logowania przez konto Fundacji —
# dowolny losowy ciąg, wygenerowany lokalnie, nigdy niewspółdzielony.
AUTH_SECRET=wygeneruj-lokalnie-losowy-ciag
