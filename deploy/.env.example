# Szablon pliku srodowiskowego srodowiska odbiorczego psychon-dev.
#
# Skopiuj ten plik NA SERWERZE jako /opt/psychon/.env i uzupelnij trzy wartosci
# z sekcji "DO UZUPELNIENIA". Nic wiecej nie zmieniaj.
#
#   sudo -u deploy cp /opt/psychon/repo/deploy/.env.example /opt/psychon/.env
#   sudo -u deploy chmod 600 /opt/psychon/.env
#   sudo -u deploy nano /opt/psychon/.env
#
# W TYM PLIKU NIE MA I NIGDY NIE BEDZIE PRAWDZIWYCH WARTOSCI. Plik z prawdziwymi
# wartosciami (/opt/psychon/.env) nie trafia do repozytorium i ma prawa 600, czyli
# czyta go wylacznie uzytkownik `deploy`.
#
# Zadnego tokenu Cloudflare tu nie ma i nie moze byc: dostepem do srodowiska
# steruje Cloudflare Access po stronie Cloudflare, a nie plik na serwerze.

# =============================================================================
# DO UZUPELNIENIA - trzy wartosci, kazda generowana jedna komenda
# =============================================================================

# 1. Haslo bazy danych srodowiska odbiorczego. Wymysl je maszyna, nie czlowiek.
#    Wygeneruj i wklej wynik:
#        openssl rand -hex 24
DB_PASSWORD=

# 2. Klucz aplikacji (Laravel szyfruje nim ciasteczka sesji). Wygeneruj i wklej
#    CALY wynik razem z przedrostkiem `base64:`:
#        echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# 3. Klucz podpisu ciasteczka logowania po stronie interfejsu. Wygeneruj i wklej:
#        openssl rand -hex 32
AUTH_SECRET=

# =============================================================================
# JUZ WYPELNIONE - nie zmieniaj
# =============================================================================

# Adres, pod ktorym stoi srodowisko odbiorcze.
STAGING_DOMAIN=psychon-dev.niepodzielni.com

# Nazwa bazy i uzytkownika bazy. Haslo jest wyzej.
DB_DATABASE=niepodzielni
DB_USERNAME=niepodzielni

# Podglad poczty (mailpit) slucha tylko na petli zwrotnej serwera - z zewnatrz
# jest niedostepny, wchodzi sie przez tunel SSH.
NP_MAILPIT_PORT=8025

# =============================================================================
# WYPELNIANE PRZY URUCHOMIENIU - zostaw puste, wpisuje je osoba stawiajaca stos
# =============================================================================
# Adresy tymczasowego dostawcy tozsamosci (logowanie kontem Fundacji).
# Sa dwa i to nie jest pomylka: pierwszy to adres, ktory widzi PRZEGLADARKA,
# drugi to adres, pod ktorym widzi go SERWER wewnatrz sieci kontenerow.
KEYCLOAK_ISSUER=
KEYCLOAK_DISCOVERY_BASE=
AUTH_KEYCLOAK_ISSUER=

# Zaufanie do certyfikatu tymczasowego dostawcy tozsamosci: wskazujemy plik CA,
# nigdy nie wylaczamy sprawdzania. `true` w drugiej linii oznaczaloby, ze
# serwer przyjmuje dowolny certyfikat - w srodowisku odbiorczym to jest bledem.
KEYCLOAK_CA_FILE=
KEYCLOAK_INSECURE_TLS=false
