# Szablon konfiguracji kopii zapasowych i monitoringu srodowiska produkcyjnego.
# Skopiuj jako kopie.env (obok tego pliku albo w innej sciezce, wskazanej jako
# pierwszy argument skryptow) i uzupelnij wartosci dla docelowego hosta.
#
# W TYM PLIKU NIE MA I NIGDY NIE BEDZIE PRAWDZIWYCH SEKRETOW - wszystkie
# ponizsze wartosci to nazwy projektu/uzytkownikow/katalogow/progi, nie hasla.
# Zrzut bazy dzieje sie przez `docker compose exec` (polaczenie lokalne,
# gniazdo unixowe) - hasla bazy tu nie ma i nie jest potrzebne.

# Nazwa projektu docker compose - TA SAMA wartosc, ktora ustawia stos
# (parametr "-p" przy `docker compose`).
PROJEKT_COMPOSE=psychon-prod

# Uzytkownik i nazwa bazy - te same zmienne, ktorych compose uzywa do
# uruchomienia kontenera bazy (POSTGRES_USER / POSTGRES_DB). Bez tego skrypt
# zgadywalby nazwe na sztywno, a to prędzej czy pozniej sie rozjedzie.
DB_UZYTKOWNIK=niepodzielni
DB_NAZWA=niepodzielni

# Katalog na hoscie, w ktorym licza sie kopie. Zakladany z prawami 700.
KATALOG_KOPII=/var/backups/psychon

# Katalog storage aplikacji (montowany do kontenera jako bind-mount) -
# archiwizowany wprost z hosta, bez posrednictwa dockera.
KATALOG_STORAGE=/opt/psychon/repo/backend/storage

# Ile ostatnich dni kopii zostaje po rotacji. Kopia z dzisiejsza data nigdy
# nie jest usuwana, niezaleznie od tej liczby.
RETENCJA_DNI=14

# Tabele, z ktorych liczba wierszy trafia do logu kopii (oddzielone spacja).
TABELE_KONTROLNE="users editions applications courses"

# Cel kopii POZA HOSTEM (opcjonalny) - katalog albo punkt montowania, na ktory
# kopiuje sie plik bazy i plik storage PO kopii lokalnej. Puste = krok jest
# POMIJANY, z wpisem w logu - nie cicho.
CEL_ZEWNETRZNY=

# Prog zajetosci dysku (procent) dla monitoringu - przy przekroczeniu idzie
# powiadomienie.
PROG_DYSKU_PROC=90

# Sciezka, na ktorej monitoring mierzy zajetosc dysku (partycja z kopiami).
SCIEZKA_DYSKU=/var/backups/psychon

# Nazwy uslug compose monitorowane co do stanu kontenera (oddzielone spacja).
USLUGI_MONITOROWANE="app queue pgsql redis mailpit"

# Adres, pod ktorym monitoring sprawdza odpowiedz aplikacji. Dedykowanej
# trasy zdrowia dzis nie ma - to jest adres tego, co odpowiada zamiast niej
# (strona startowa aplikacji).
ADRES_KONTROLI_HTTP=http://127.0.0.1:8080/
KOD_HTTP_OCZEKIWANY=200

# Adres, na ktory monitoring wysyla powiadomienia - wpisuje wlasciciel.
ADRES_ALERTOW=

# Serwer poczty uzywany do powiadomien - te same wartosci co w .env aplikacji
# (MAIL_HOST/MAIL_PORT), podane tu osobno, bo ten skrypt nie czyta .env
# aplikacji wprost.
POCZTA_HOST=mailpit
POCZTA_PORT=1025
POCZTA_NADAWCA=monitoring@psychon.local

# Katalog na plik stanu monitoringu - dzieki niemu powiadomienie idzie tylko
# przy ZMIANIE stanu, nie przy kazdym uruchomieniu.
KATALOG_STANU=/var/lib/psychon-monitoring
